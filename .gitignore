.env
.env.openai
.env.llama
__pycache__/
**/__pycache__/
*.pyc
.venv/
*.egg-info/
.DS_Store
**/.DS_Store
artifacts/*
gepa_logs
gepa_logs_*

# SQLite DB — per-machine state (projects, jobs, runs, memory).
# Auto-recreated empty on first uvicorn startup via Base.metadata.create_all.
annotagent/backend/annotagent.db
annotagent/backend/annotagent.db-journal
annotagent/backend/annotagent.db-wal
annotagent/backend/annotagent.db-shm

# Backend filesystem audit trail (DB is canonical; this dir is a mirror)
annotagent/backend/workspace/

# Legacy artifacts that shouldn't be tracked even though they live under legacy/
legacy/vis/
legacy/
reference.md

annotagent/frontend/node_modules/
annotagent/frontend/dist/assets/
annotagent/frontend/dist/
annotagent/frontend/.vite/
paper_draft
# Experiment results and scratch data at the repo root.
# Ignore root-level json / md / xlsx, but keep README.md and CLAUDE.md.
/*.json
/*.xlsx
/*.md
!/README.md
!/CLAUDE.md
review-stage/
emnlp2025_demo_study/
EMNLP26_Demo_AnnotAgent/

# Experiment run outputs — regenerable optimizer result sidecars, trajectories,
# and run logs. Collected under exp_result/; kept on disk for audit, not tracked.
# The scripts/*.json,*.log rules cover fresh runs that write into scripts/.
exp_result/
annotagent/backend/scripts/*.json
annotagent/backend/scripts/*.log